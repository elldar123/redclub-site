PORT=5500
NODE_ENV=development

# API LX credentials — never put these in frontend files
APILX_BASE_URL=https://api-lx.com
APILX_TOKEN=
APILX_CALLBACK_URL=http://localhost:5500/api/callback/apilx
APILX_CURRENCY=USD
APILX_PROVIDER=pragmatic

# Set this only after API LX confirms the exact route and request format
APILX_LAUNCH_PATH=/v1/games/launch
APILX_GAMES_PATH=/v1/games
